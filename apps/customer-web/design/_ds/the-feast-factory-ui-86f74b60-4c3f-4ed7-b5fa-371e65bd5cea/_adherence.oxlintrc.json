{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Button/**",
              "components/general/Checkbox/**",
              "components/general/ChoiceCard/**",
              "components/general/DateField/**",
              "components/general/Field/**",
              "components/general/Input/**",
              "components/general/Select/**",
              "components/general/Textarea/**",
              "components/general/TimeField/**",
              "redesign/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|asChild|children|className|disabled|onClick|type|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, asChild, children, className, disabled, onClick, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline)$/]",
        "message": "<Button> variant must be one of 'default' | 'secondary' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|checked|onCheckedChange|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, description, checked, onCheckedChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|description|selected|onSelect|children|key|ref|className|style|children)$/]",
        "message": "<ChoiceCard> doesn't accept that prop. Declared props: label, description, selected, onSelect, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DateField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|onValueChange|required|key|ref|className|style|children)$/]",
        "message": "<DateField> doesn't accept that prop. Declared props: value, min, onValueChange, required."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|optional|children|className|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, optional, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|placeholder|value|defaultValue|onChange|disabled|required|type|name|id|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: className, placeholder, value, defaultValue, onChange, disabled, required, type, name, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|required|disabled|className|children|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: value, onChange, required, disabled, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|required|disabled|maxLength|className|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: value, onChange, placeholder, required, disabled, maxLength, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onValueChange|required|key|ref|className|style|children)$/]",
        "message": "<TimeField> doesn't accept that prop. Declared props: value, onValueChange, required."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": { "replaces": [] },
      "Checkbox": { "replaces": [] },
      "ChoiceCard": { "replaces": [] },
      "DateField": { "replaces": [] },
      "Field": { "replaces": [] },
      "Input": { "replaces": [] },
      "Select": { "replaces": [] },
      "Textarea": { "replaces": [] },
      "TimeField": { "replaces": [] }
    },
    "tokens": [
      "--accent", "--accent-foreground", "--background", "--border",
      "--card", "--card-foreground", "--foreground", "--muted",
      "--muted-foreground", "--primary", "--primary-foreground"
    ],
    "tokenKinds": {
      "--primary": "color", "--primary-foreground": "color",
      "--accent": "color", "--accent-foreground": "color",
      "--background": "color", "--foreground": "color",
      "--card": "color", "--card-foreground": "color",
      "--muted": "color", "--muted-foreground": "color",
      "--border": "color"
    },
    "fontFamilies": []
  }
}