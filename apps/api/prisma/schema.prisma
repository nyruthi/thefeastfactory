// =============================================================================
// Catering & Event Ordering Platform — Prisma Schema
// Version: 1.0  |  Status: Phase 1 MVP
// Database: PostgreSQL via Google Cloud SQL
// ORM: Prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

enum AdminRole {
  ADMIN
  OPERATIONS
}

enum AddressType {
  HOME
  OFFICE
  EVENT_VENUE
  OTHER
}

enum EventStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum CancellationActor {
  CUSTOMER
  ADMIN
}

enum NotificationType {
  ORDER_CONFIRMED
  ORDER_IN_PROGRESS
  ORDER_READY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_FAILED
  REFUND_UPDATED
}

enum DocumentType {
  PAYMENT_RECEIPT
  GST_INVOICE
  REFUND_CREDIT_NOTE
}

// =============================================================================
// CUSTOMER DOMAIN
// =============================================================================

model User {
  id            String    @id @default(uuid())
  mobileNumber  String    @unique @map("mobile_number") @db.VarChar(15)
  name          String?   @db.VarChar(100)
  email         String?   @db.VarChar(255)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // soft delete — never hard delete

  // Relations
  addresses     UserAddress[]
  events        Event[]
  orders        Order[]
  notifications Notification[]
  documents     OrderDocument[]

  @@index([mobileNumber])
  @@index([isActive])
  @@map("users")
}

model UserAddress {
  id           String      @id @default(uuid())
  userId       String      @map("user_id")
  addressType  AddressType @default(HOME) @map("address_type")
  label        String?     @db.VarChar(50)  // e.g. "Home", "Office", "Wedding Venue"
  addressLine1 String      @map("address_line1") @db.VarChar(255)
  addressLine2 String?     @map("address_line2") @db.VarChar(255)
  city         String      @db.VarChar(100)
  state        String      @db.VarChar(100)
  pincode      String      @db.VarChar(10)
  landmark     String?     @db.VarChar(255)
  latitude     Decimal?    @db.Decimal(10, 8)
  longitude    Decimal?    @db.Decimal(11, 8)
  isDefault    Boolean     @default(false) @map("is_default")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Relations
  user         User        @relation(fields: [userId], references: [id])
  events       Event[]

  @@index([userId])
  @@index([userId, isDefault])
  @@map("user_addresses")
}

// =============================================================================
// MENU DOMAIN
// =============================================================================

model MenuCategory {
  id          String     @id @default(uuid())
  name        String     @unique @db.VarChar(100)
  description String?    @db.VarChar(500)
  displayOrder Int       @default(0) @map("display_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  // Relations
  menuItems            MenuItem[]
  packageCategoryRules PackageCategoryRule[]
  packageMenuItems     PackageMenuItem[]
  orderSelectedItems   OrderSelectedItem[]

  @@index([isActive])
  @@map("menu_categories")
}

model MenuItem {
  id          String       @id @default(uuid())
  categoryId  String       @map("category_id")
  name        String       @db.VarChar(150)
  description String?      @db.VarChar(1000)
  // IMPORTANT: All prices stored in Indian Rupees as Decimal(10,2) — never Float
  basePrice   Decimal      @map("base_price") @db.Decimal(10, 2)
  isVeg       Boolean      @default(true) @map("is_veg")
  isActive    Boolean      @default(true) @map("is_active")
  imageUrl    String?      @map("image_url") @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at") // soft delete — referenced by orders

  // Relations
  category             MenuCategory           @relation(fields: [categoryId], references: [id])
  packageMenuItems     PackageMenuItem[]
  packageMenuItemPricing PackageMenuItemPricing[]
  orderSelectedItems   OrderSelectedItem[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([isActive])
  @@map("menu_items")
}

// =============================================================================
// PACKAGE DOMAIN
// =============================================================================

model Package {
  id              String           @id @default(uuid())
  name            String           @unique @db.VarChar(100)
  description     String?          @db.VarChar(1000)
  isCustom        Boolean          @default(false) @map("is_custom")
  isActive        Boolean          @default(true) @map("is_active")
  displayOrder    Int              @default(0) @map("display_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  // Relations
  versions        PackageVersion[]

  @@index([isActive])
  @@map("packages")
}

model PackageVersion {
  id                  String                   @id @default(uuid())
  packageId           String                   @map("package_id")
  versionNo           Int                      @map("version_no")
  // IMPORTANT: All prices in Indian Rupees as Decimal(10,2)
  basePricePerPlate   Decimal                  @map("base_price_per_plate") @db.Decimal(10, 2)
  minGuestCount       Int                      @default(10) @map("min_guest_count")
  maxGuestCount       Int?                     @map("max_guest_count")
  isActive            Boolean                  @default(true) @map("is_active")
  publishedAt         DateTime?                @map("published_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  // Relations
  package             Package                  @relation(fields: [packageId], references: [id])
  categoryRules       PackageCategoryRule[]
  packageMenuItems    PackageMenuItem[]
  packageMenuItemPricing PackageMenuItemPricing[]
  events              Event[]

  @@unique([packageId, versionNo])
  @@index([packageId, isActive])
  @@map("package_versions")
}

// Defines how many items a customer must select from each category
// e.g. Starter → min: 2, max: 2 | Main Course → min: 3, max: 3
model PackageCategoryRule {
  id               String         @id @default(uuid())
  packageVersionId String         @map("package_version_id")
  categoryId       String         @map("category_id")
  minSelections    Int            @default(1) @map("min_selections")
  maxSelections    Int            @map("max_selections")
  isMandatory      Boolean        @default(true) @map("is_mandatory")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id])
  category         MenuCategory   @relation(fields: [categoryId], references: [id])

  @@unique([packageVersionId, categoryId])
  @@index([packageVersionId])
  @@map("package_category_rules")
}

// Defines which menu items are available within a package version
model PackageMenuItem {
  id               String         @id @default(uuid())
  packageVersionId String         @map("package_version_id")
  categoryId       String         @map("category_id")   // denormalised from menu_item for fast filtering
  menuItemId       String         @map("menu_item_id")
  isAvailable      Boolean        @default(true) @map("is_available")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Relations
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id])
  category         MenuCategory   @relation(fields: [categoryId], references: [id])
  menuItem         MenuItem       @relation(fields: [menuItemId], references: [id])

  @@unique([packageVersionId, menuItemId])
  @@index([packageVersionId, categoryId])
  @@map("package_menu_items")
}

// Defines the upgrade pricing when a dish is "premium" relative to the package's base inclusion value
// Customization charge = item_price - included_value (if > 0, else 0)
model PackageMenuItemPricing {
  id                String         @id @default(uuid())
  packageVersionId  String         @map("package_version_id")
  menuItemId        String         @map("menu_item_id")
  // IMPORTANT: All prices in Indian Rupees as Decimal(10,2)
  itemPrice         Decimal        @map("item_price") @db.Decimal(10, 2)      // actual price of item in this package context
  includedValue     Decimal        @map("included_value") @db.Decimal(10, 2)  // value covered by base package price
  // upgradeCharge = max(itemPrice - includedValue, 0) — computed by application, not stored
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  packageVersion    PackageVersion @relation(fields: [packageVersionId], references: [id])
  menuItem          MenuItem       @relation(fields: [menuItemId], references: [id])

  @@unique([packageVersionId, menuItemId])
  @@index([packageVersionId])
  @@map("package_menu_item_pricing")
}

// =============================================================================
// EVENT DOMAIN
// =============================================================================

model Event {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  packageVersionId String      @map("package_version_id")
  addressId        String      @map("address_id")
  regionId         String?     @map("region_id")
  eventName        String?     @map("event_name") @db.VarChar(200)  // e.g. "Rahul's Birthday"
  eventDate        DateTime    @map("event_date") @db.Date
  eventTimeStart   DateTime?   @map("event_time_start") @db.Time
  guestCount       Int         @map("guest_count")
  distanceKm       Decimal?    @map("distance_km") @db.Decimal(8, 2)
  deliveryFee      Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  status           EventStatus @default(DRAFT)
  specialNotes     String?     @map("special_notes") @db.VarChar(1000)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  // Relations
  user             User           @relation(fields: [userId], references: [id])
  packageVersion   PackageVersion @relation(fields: [packageVersionId], references: [id])
  address          UserAddress    @relation(fields: [addressId], references: [id])
  region           OperatingRegion? @relation(fields: [regionId], references: [id])
  orders           Order[]

  @@index([userId])
  @@index([eventDate, status])
  @@index([regionId, eventDate])
  @@index([userId, eventDate])
  @@map("events")
}

// =============================================================================
// ORDER DOMAIN
// =============================================================================

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number") @db.VarChar(20) // e.g. ORD-20240613-0001
  userId          String        @map("user_id")
  eventId         String        @map("event_id")
  regionId        String?       @map("region_id")

  // Pricing snapshot — never recalculate from master tables
  // IMPORTANT: All amounts in Indian Rupees as Decimal(10,2)
  guestCount                Int      @map("guest_count")
  basePerPlatePrice         Decimal  @map("base_per_plate_price") @db.Decimal(10, 2)
  totalCustomizationCharges Decimal  @default(0) @map("total_customization_charges") @db.Decimal(10, 2)
  finalPerPlatePrice        Decimal  @map("final_per_plate_price") @db.Decimal(10, 2)
  totalAmount               Decimal  @map("total_amount") @db.Decimal(10, 2)
  distanceKm                Decimal? @map("distance_km") @db.Decimal(8, 2)
  deliveryFee               Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  // totalAmount = (finalPerPlatePrice × guestCount) + deliveryFee (stored for audit; must match at order creation)

  // Package snapshot — preserves package name/version at time of order
  packageName               String   @map("package_name") @db.VarChar(100)
  packageVersionNo          Int      @map("package_version_no")

  orderStatus     OrderStatus   @default(DRAFT) @map("order_status")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")

  // Cancellation
  cancelledAt     DateTime?         @map("cancelled_at")
  cancelledBy     CancellationActor? @map("cancelled_by")
  cancellationReason String?        @map("cancellation_reason") @db.VarChar(500)
  cancelledByAdminId String?        @map("cancelled_by_admin_id") // set if admin cancelled

  // Advance notice enforcement
  bookingLeadHours Int?   @map("booking_lead_hours") // hours between booking and event, stored at creation

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  user            User              @relation(fields: [userId], references: [id])
  event           Event             @relation(fields: [eventId], references: [id])
  region          OperatingRegion?  @relation(fields: [regionId], references: [id])
  selectedItems   OrderSelectedItem[]
  payments        Payment[]
  statusHistory   OrderStatusHistory[]
  notes           OrderNote[]
  notifications   Notification[]
  documents       OrderDocument[]
  cancelledByAdmin AdminUser?       @relation("OrderCancelledByAdmin", fields: [cancelledByAdminId], references: [id])

  @@index([orderNumber])
  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([regionId, orderStatus])
  @@index([regionId, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

// Immutable snapshot of each selected dish at time of order placement
// NEVER update these rows after order is placed — they are the audit record
model OrderSelectedItem {
  id             String   @id @default(uuid())
  orderId        String   @map("order_id")
  categoryId     String   @map("category_id")
  menuItemId     String   @map("menu_item_id")

  // Snapshot fields — copied from master tables at order creation time
  menuItemName         String  @map("menu_item_name") @db.VarChar(150)
  categoryName         String  @map("category_name") @db.VarChar(100)
  isVeg                Boolean @map("is_veg")
  // IMPORTANT: All prices in Indian Rupees as Decimal(10,2)
  itemPrice            Decimal @map("item_price") @db.Decimal(10, 2)         // price at time of order
  includedValue        Decimal @map("included_value") @db.Decimal(10, 2)     // package-covered value
  adjustmentAmount     Decimal @default(0) @map("adjustment_amount") @db.Decimal(10, 2) // = max(itemPrice - includedValue, 0)

  createdAt      DateTime @default(now()) @map("created_at")

  // Relations (kept for reporting joins, but snapshot fields are source of truth for pricing)
  order          Order        @relation(fields: [orderId], references: [id])
  category       MenuCategory @relation(fields: [categoryId], references: [id])
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@index([orderId, categoryId])
  @@map("order_selected_items")
}

// =============================================================================
// PAYMENT DOMAIN
// =============================================================================

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")

  // IMPORTANT: Amount in Indian Rupees as Decimal(10,2)
  amount          Decimal       @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")

  // Razorpay uses three separate IDs — all three are required
  // razorpayOrderId  → created when we initiate a payment (before customer pays)
  // razorpayPaymentId → returned after successful capture
  // razorpaySignature → HMAC for server-side verification; must be stored for audit
  razorpayOrderId    String?  @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId  String?  @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature  String?  @map("razorpay_signature") @db.VarChar(500)

  // Raw webhook payload stored as JSONB for dispute resolution and audit
  gatewayResponse    Json?    @map("gateway_response")

  paymentMethod   String?       @map("payment_method") @db.VarChar(50)  // upi, card, netbanking, etc.
  paidAt          DateTime?     @map("paid_at")
  failureReason   String?       @map("failure_reason") @db.VarChar(500)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  order           Order         @relation(fields: [orderId], references: [id])
  refunds         Refund[]
  documents       OrderDocument[]

  @@index([orderId])
  @@index([paymentStatus])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@map("payments")
}

// Tracks every refund against a payment (partial or full)
model Refund {
  id              String       @id @default(uuid())
  paymentId       String       @map("payment_id")

  // IMPORTANT: Amount in Indian Rupees as Decimal(10,2)
  amount          Decimal      @db.Decimal(10, 2)
  refundStatus    RefundStatus @default(INITIATED) @map("refund_status")

  razorpayRefundId String?     @map("razorpay_refund_id") @db.VarChar(100)
  reason          String?      @db.VarChar(500)
  initiatedById   String?      @map("initiated_by_id")  // admin user ID if admin-initiated
  gatewayResponse Json?        @map("gateway_response") // raw Razorpay refund response

  initiatedAt     DateTime     @default(now()) @map("initiated_at")
  processedAt     DateTime?    @map("processed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  payment         Payment      @relation(fields: [paymentId], references: [id])
  documents       OrderDocument[]

  @@index([paymentId])
  @@index([refundStatus])
  @@index([razorpayRefundId])
  @@map("refunds")
}

// =============================================================================
// ADMINISTRATION DOMAIN
// =============================================================================

model AdminUser {
  id          String    @id @default(uuid())
  email       String    @unique @db.VarChar(255)
  name        String    @db.VarChar(100)
  role        AdminRole
  regionId    String?   @map("region_id")
  passwordHash String   @map("password_hash") @db.VarChar(255)
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  orderStatusHistory  OrderStatusHistory[]
  cancelledOrders     Order[]    @relation("OrderCancelledByAdmin")
  orderNotes          OrderNote[]
  region              OperatingRegion? @relation(fields: [regionId], references: [id])

  @@index([email])
  @@index([isActive])
  @@index([regionId])
  @@map("admin_users")
}

model OperatingRegion {
  id               String   @id @default(uuid())
  code             String   @unique @db.VarChar(40)
  name             String   @db.VarChar(100)
  centerLatitude   Decimal  @map("center_latitude") @db.Decimal(10, 8)
  centerLongitude  Decimal  @map("center_longitude") @db.Decimal(11, 8)
  serviceRadiusKm  Decimal  @default(50) @map("service_radius_km") @db.Decimal(8, 2)
  deliveryFeePerKm Decimal  @default(10) @map("delivery_fee_per_km") @db.Decimal(10, 2)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  admins           AdminUser[]
  events           Event[]
  orders           Order[]

  @@index([isActive])
  @@map("operating_regions")
}

// Immutable audit trail of every order status transition
model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  fromStatus  OrderStatus? @map("from_status") // null for initial DRAFT entry
  toStatus    OrderStatus  @map("to_status")
  changedById String?      @map("changed_by_id")  // admin user ID; null if system/customer triggered
  notes       String?      @db.VarChar(500)
  changedAt   DateTime     @default(now()) @map("changed_at")

  // Relations
  order       Order       @relation(fields: [orderId], references: [id])
  changedBy   AdminUser?  @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model PaymentWebhookEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique @map("provider_event_id") @db.VarChar(150)
  eventType       String    @map("event_type") @db.VarChar(100)
  payload         Json
  processedAt     DateTime? @map("processed_at")
  processingError String?   @map("processing_error") @db.VarChar(1000)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([eventType])
  @@index([processedAt])
  @@map("payment_webhook_events")
}

model OrderNote {
  id        String    @id @default(uuid())
  orderId   String    @map("order_id")
  authorId  String    @map("author_id")
  body      String    @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  order     Order     @relation(fields: [orderId], references: [id])
  author    AdminUser @relation(fields: [authorId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_notes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  orderId   String?          @map("order_id")
  type      NotificationType
  title     String           @db.VarChar(150)
  message   String           @db.VarChar(500)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id])
  order     Order?           @relation(fields: [orderId], references: [id])

  @@index([userId, readAt, createdAt])
  @@index([orderId])
  @@map("notifications")
}

model OrderDocument {
  id             String       @id @default(uuid())
  orderId        String       @map("order_id")
  userId         String       @map("user_id")
  paymentId      String?      @map("payment_id")
  refundId       String?      @map("refund_id")
  documentType   DocumentType @map("document_type")
  documentNumber String       @unique @map("document_number") @db.VarChar(50)
  snapshot       Json
  generatedAt    DateTime     @default(now()) @map("generated_at")

  order          Order        @relation(fields: [orderId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  refund         Refund?      @relation(fields: [refundId], references: [id])

  @@index([orderId, documentType])
  @@index([userId, generatedAt])
  @@map("order_documents")
}

// =============================================================================
// PLATFORM CONFIGURATION
// =============================================================================

// Stores configurable business rules — avoids hardcoding in application code
model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String   @db.VarChar(500)
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Example seed values:
  // key: "min_booking_lead_hours", value: "48"
  // key: "otp_expiry_seconds",     value: "300"
  // key: "otp_max_attempts",       value: "5"
  // key: "razorpay_currency",      value: "INR"

  @@map("platform_settings")
}

// =============================================================================
// OTP MANAGEMENT
// =============================================================================

// Stores OTP state server-side — do not rely solely on SMS provider
model OtpVerification {
  id           String    @id @default(uuid())
  mobileNumber String    @map("mobile_number") @db.VarChar(15)
  otpHash      String    @map("otp_hash") @db.VarChar(255)  // bcrypt hash of OTP — never store plain
  attempts     Int       @default(0)
  isVerified   Boolean   @default(false) @map("is_verified")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([mobileNumber, isVerified])
  @@index([expiresAt])
  @@map("otp_verifications")
}
