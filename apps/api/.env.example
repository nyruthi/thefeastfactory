# Example environment variables for @aranyam/api
# Copy this file to `.env` inside the apps/api folder or export the variables in PowerShell before running scripts.
# Replace username/password/dbname with the values you create in your local Postgres.

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL="postgresql://aranyam:AranyamPass1@localhost:5432/aranyam_dev?schema=public"

# Optional: Node env
NODE_ENV=development
