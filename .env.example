# Email provider: Resend
RESEND_API_KEY=""
EMAIL_FROM="Aranyam <orders@example.com>"

# Object storage: Google Cloud Storage
GCP_PROJECT_ID=""
GCP_STORAGE_BUCKET=""
GOOGLE_APPLICATION_CREDENTIALS=""

# Observability
