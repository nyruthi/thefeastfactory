                  "pm.test('admin login succeeded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('adminAccessToken', json.accessToken);",
